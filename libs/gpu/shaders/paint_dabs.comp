struct Circle {
    vec4 color;
    float centerX; float centerY; float cosa; float sina;
    float xcoef; float ycoef; float fadeX; float fadeY;
    float distfactor; float center; float alphafactor; float radius;
    float fadeStart; float fadeStartValue; float fadeCoeff; uint kind;
