} params;

// Vulkan rounds float add, subtract and multiply correctly, and NVIDIA
// fma() is fused, but division and sqrt may be off by a few ulp. The CPU
// rounds them correctly (SSE/AVX), and the Gaussian fade has thresholds, so
// choose the neighbor whose exact residual (fma) is smallest.
float neighborFloat(float x, int steps)
{
    return uintBitsToFloat(uint(int(floatBitsToUint(x)) + steps));
}

// Correctly rounded a / b for finite a >= 0 and b > 0.
float exactDivide(float a, float b)
{
    precise float q = a / b;
    if (a == 0.0 || isinf(q))
        return q;
    float best = q;
    float bestResidual = abs(fma(-q, b, a));
    for (int i = -2; i <= 2; ++i) {
        precise float candidate = neighborFloat(q, i);
        precise float residual = abs(fma(-candidate, b, a));
        if (i != 0 && candidate >= 0.0 && residual < bestResidual) {
            best = candidate;
            bestResidual = residual;
        }
    }
    return best;
}

// Correctly rounded sqrt(x) for finite x >= 0.
float exactSqrt(float x)
{
    precise float s = sqrt(x);
    if (x == 0.0)
        return 0.0;
    float best = s;
    float bestResidual = abs(fma(-s, s, x));
    for (int i = -2; i <= 2; ++i) {
        precise float candidate = neighborFloat(s, i);
        precise float residual = abs(fma(-candidate, candidate, x));
        if (i != 0 && candidate >= 0.0 && residual < bestResidual) {
            best = candidate;
            bestResidual = residual;
        }
    }
    return best;
}

// xsimd exp<float> on FMA architectures (KisProceduralCircleDab::fusedExp).
float fusedExp(float a)
{
    precise float k = roundEven(1.44269502162933349609375 * a);
    precise float x = fma(-k, uintBitsToFloat(0x3f318000u), a);
    x = fma(-k, uintBitsToFloat(0xb95e8083u), x);
    precise float y = fma(x,
                          fma(x,
                              fma(x, fma(x, uintBitsToFloat(0x3ab778cfu), uintBitsToFloat(0x3c098d8bu)),
                                  uintBitsToFloat(0x3d2aa957u)),
                              uintBitsToFloat(0x3e2aa9a5u)),
                          uintBitsToFloat(0x3f000000u));
    precise float x2 = x * x;
    precise float result = fma(y, x2, x) + 1.0;
    result = result * uintBitsToFloat(uint(int(k) + 127) << 23);
    if (a <= -88.3762626647949)
        return 0.0;
    if (a >= 88.3762626647949)
        return uintBitsToFloat(0x7f800000u);
    return result;
}

// VcExtraMath::erf (KisProceduralCircleDab::vectorErf).
float vectorErf(float x)
{
    precise float xa = abs(x);
    bool limit = xa >= 9.3;
    if (limit)
        xa = 0.0;
    float sign = x < 0.0 ? -1.0 : 1.0;
    precise float denominator = fma(xa, 0.3275911, 1.0);
    precise float t = exactDivide(1.0, denominator);
    precise float e = fusedExp(-xa * xa);
    precise float poly = fma(fma(fma(fma(1.061405429, t, -1.453152027), t, 1.421413741), t, -0.284496736), t, 0.254829592);
    precise float pt = poly * t;
    precise float result = fma(-pt, e, 1.0);
    if (limit)
        result = 1.0;
    return sign * result;
}

float circleFade(Circle c, ivec2 p)
{
    precise float y_ = float(p.y) - c.centerY;
    precise float sinay_ = c.sina * y_;
    precise float cosay_ = c.cosa * y_;
    precise float x_ = float(p.x) - c.centerX;
    precise float xr = fma(x_, c.cosa, -sinay_);
    precise float yr = fma(x_, c.sina, cosay_);
    precise float a = xr * c.xcoef;
    precise float b = yr * c.ycoef;
    precise float b2 = b * b;
    precise float n = fma(a, a, b2);
    precise float fade = 1.0;
    if (!(n > 1.0)) {
        if (c.antialias != 0) {
            xr = abs(xr) + 1.0;
            yr = abs(yr) + 1.0;
        }
        precise float fa = xr * c.fadeX;
        precise float fb = yr * c.fadeY;
        precise float fa2 = fa * fa;
        precise float normFade = fma(fb, fb, fa2);
        precise float numerator = n * (normFade - 1.0);
        precise float denominator = normFade - n;
        fade = normFade < 1.0 ? 0.0 : exactDivide(numerator, denominator);
    }
    return fade;
}

float gaussFade(Circle c, ivec2 p)
{
    precise float y_ = float(p.y) - c.centerY;
    precise float sinay_ = c.sina * y_;
    precise float cosay_ = c.cosa * y_;
    precise float x_ = float(p.x) - c.centerX;
    precise float xr = fma(x_, c.cosa, -sinay_);
    precise float yr = fma(x_, c.sina, cosay_);
    precise float b = yr * c.ycoef;
    precise float b2 = b * b;
    precise float squared = fma(xr, xr, b2);
    precise float dist = exactSqrt(squared);

    // KisAntialiasingFadeMaker1D::needFade() (vector form).
    bool outside = dist > c.radius;
    if (outside)
        dist = 1.0;
    bool fadeStartMask = false;
    if (c.antialias != 0) {
        fadeStartMask = dist > c.fadeStart;
        if (fadeStartMask && !outside) {
            precise float ramp = fma(dist - c.fadeStart, c.fadeCoeff, c.fadeStartValue);
            dist = exactDivide(ramp, 255.0);
        }
    }
    if (outside || fadeStartMask)
        return dist;

    precise float valDist = dist * c.distfactor;
    precise float fullFade = (vectorErf(valDist + c.center) - vectorErf(valDist - c.center)) * c.alphafactor;
    if (fullFade < 0.0)
        fullFade = 0.0;
    if (fullFade > 254.974)
        return 0.0;
    return exactDivide(255.0 - fullFade, 255.0);
}

// Imath (OpenEXR 2) half(float): round to nearest even, denormals included.
// Alpha is finite and in [0, 1].
float roundToHalf(float value)
{
    uint x = floatBitsToUint(value);
    if (value == 0.0)
        return value;
    uint sign = (x >> 16) & 0x8000u;
    int e = int((x >> 23) & 0xffu) - 127 + 15;
    uint m = x & 0x007fffffu;
    uint h;
    if (e <= 0) {
        if (e < -10)
            return uintBitsToFloat(sign << 16);
        m |= 0x00800000u;
        int t = 14 - e;
        uint a = (1u << uint(t - 1)) - 1u;
        uint b = (m >> uint(t)) & 1u;
        h = sign | ((m + a + b) >> uint(t));
    } else {
        h = (sign | (uint(e) << 10)) + ((m + 0x00000fffu + ((m >> 13) & 1u)) >> 13);
    }
    return unpackHalf2x16(h).x;
}

// KisCurveCircleMaskGenerator (KisProceduralCircleDab::softFadeAt).
float softFade(Circle c, ivec2 p)
{
    precise float y_ = float(p.y) - c.centerY;
    precise float sinay_ = c.sina * y_;
    precise float cosay_ = c.cosa * y_;
    precise float x_ = float(p.x) - c.centerX;
    precise float xr = fma(x_, c.cosa, -sinay_);
    precise float yr = fma(x_, c.sina, cosay_);
    precise float a = xr * c.xcoef;
    precise float b = yr * c.ycoef;
    precise float b2 = b * b;
    precise float dist = fma(a, a, b2);

    bool outside = dist > c.radius;
    if (outside)
        dist = 1.0;
    bool fadeStartMask = false;
    if (c.antialias != 0) {
        fadeStartMask = dist > c.fadeStart;
        if (fadeStartMask && !outside) {
            precise float ramp = fma(dist - c.fadeStart, c.fadeCoeff, c.fadeStartValue);
            dist = exactDivide(ramp, 255.0);
        }
    }
    if (outside || fadeStartMask)
        return dist;

    precise float valDist = dist * c.curveResolution;
    int index = int(valDist);
    precise float fraction = valDist - float(index);
    if (index < 0)
        index = 0;
    CurveTable table = CurveTable(c.curveTable);
    precise float c1 = table.value[index + 1] * fraction;
    precise float full = fma(table.value[index], 1.0 - fraction, c1);
    precise float clamped = full > 0.0 ? full : 0.0;
    return clamped < 1.0 ? 1.0 - clamped : 0.0;
}

vec4 generatedCircle(Circle c, ivec2 p)
{
    precise float fade = c.kind == 1 ? gaussFade(c, p) : c.kind == 2 ? softFade(c, p) : circleFade(c, p);
    // KoColorSpaceTrait::fillInverseAlphaNormedFloatMaskWithColor: unit * (1 - fade).
    precise float alpha = 1.0 * (1.0 - fade);
    if (c.halfPixels != 0)
        alpha = roundToHalf(alpha);
    return vec4(c.color.rgb, alpha);
}

#ifdef DAB_TEXTURE
// Textured generated dab (Circle.texture != 0, RGBA32F only; see
// KisProceduralDabTexture): the pattern texel is composited into the dab
// alpha like KisMaskingBrushCompositeOp<float, mode, true, true, soft>.
// KoColorSpaceMathsTraits<float>::compositetype is float: every operation
// rounds to float in the CPU's order (`precise`), and divisions are done in
// double and rounded once, the correctly rounded float division.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer TextureBytes { uint word[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer TextureLut { float value[]; };

float txMul(float a, float b) { precise float r = a * b; return r; }
float txMul3(float a, float b, float c) { precise float ab = a * b; precise float r = ab * c; return r; }
float txDiv(float a, float b) { precise double q = double(a) / double(b); return float(q); }
float txInv(float a) { precise float r = 1.0 - a; return r; }
float txUnion(float a, float b) { const float m = txMul(a, b); precise float s = a + b; precise float r = s - m; return r; }
// qMin/qMax/kisBoundFast(0, v, 1), including their NaN behaviour
float txMin(float a, float b) { return a < b ? a : b; }
float txMax(float a, float b) { return a < b ? b : a; }
float txBound(float v) { return txMax(0.0, txMin(1.0, v)); }
bool txFuzzyZero(float v) { return abs(v) <= 0.00001; }
bool txFuzzyCompare(float a, float b) { precise float d = abs(a - b) * 100000.0; return d <= min(abs(a), abs(b)); }

// CFHardLight<float>::composeChannel(src, dst)
float txHardLight(float src, float dst)
{
    if (txFuzzyCompare(src, 0.5)) return dst;
    precise float src2 = src + src;
    if (src > 0.5) {
        src2 = src2 - 1.0;
        return txUnion(src2, dst);
    }
    return txMul(src2, dst);
}
// CFOverlay: hard light with the arguments swapped
float txOverlay(float src, float dst) { return txHardLight(dst, src); }
// colorDodgeAlpha<float>
float txDodge(float src, float dst)
{
    if (txFuzzyCompare(src, 1.0)) return txFuzzyZero(dst) ? 0.0 : 1.0;
    const float result = txBound(txDiv(dst, txInv(src)));
    return (isnan(result) || isinf(result)) ? 1.0 : result;
}
// CFColorBurn<float>
float txBurn(float src, float dst)
{
    if (dst == 1.0) return 1.0;
    const float quotient = txDiv(txInv(dst), src);
    if (isnan(quotient) || isinf(quotient)) return 0.0;
    return 1.0 - clamp(quotient, 0.0, 1.0);
}
// CFHardMixPhotoshop<float>
float txHardMix(float src, float dst) { precise float sum = src + dst; return sum > 1.0 ? 1.0 : 0.0; }
// hardMixSofterPhotoshopAlpha<float>
float txHardMixSofter(float src, float dst)
{
    precise float a = 3.0 * dst;
    precise float b = 2.0 * txInv(src);
    precise float r = a - b;
    return txBound(r);
}

float texturedAlpha(Circle c, float src, float dst)
{
    const float s = c.textureStrength;
    const float is = c.textureInvertedStrength;
    const float w = c.textureWeight;
    const bool soft = c.textureSoft != 0;
    switch (c.textureMode) {
    case 0: // MULT
        return soft ? txMul(txUnion(src, is), dst) : txMul3(src, dst, s);
    case 1: // DARKEN
        return soft ? txMin(txUnion(src, is), dst) : txMin(src, txMul(dst, s));
    case 2: // OVERLAY
        return soft ? txOverlay(txUnion(src, is), dst) : txOverlay(src, txMul(dst, s));
    case 3: // DODGE
        return soft ? txDodge(txMul(src, s), dst) : txDodge(src, txMul(dst, s));
    case 4: // BURN
        return soft ? txBurn(txUnion(src, is), dst) : txBurn(src, txMul(dst, s));
    case 5: { // LINEAR_BURN
        if (soft) {
            precise float sum = txUnion(src, is) + dst;
            precise float r = sum - 1.0;
            return txMax(0.0, r);
        }
        precise float sum = src + txMul(dst, s);
        precise float r = sum - 1.0;
        return txMax(0.0, r);
    }
    case 6: { // LINEAR_DODGE
        if (txFuzzyZero(dst)) return 0.0;
        precise float sum = soft ? txMul(src, s) + dst : src + txMul(dst, s);
        return txMin(sum, 1.0);
    }
    case 7: // HARD_MIX_PHOTOSHOP
        return soft ? txMul(txHardMix(txUnion(src, is), dst), txUnion(dst, s)) : txHardMix(src, txMul(dst, s));
    case 8: // HARD_MIX_SOFTER_PHOTOSHOP
        return soft ? txHardMixSofter(txMul(src, s), dst) : txHardMixSofter(src, txMul(dst, s));
    case 9: { // SUBTRACT
        if (soft) {
            precise float r = dst - txMul(src, s);
            return txMax(0.0, r);
        }
        precise float sum = src + is;
        precise float r = dst - sum;
        return txMax(0.0, r);
    }
    case 10: { // HEIGHT
        const float modified = txDiv(dst, is);
        if (soft) {
            precise float r = modified - txMul(src, s);
            return txBound(r);
        }
        precise float sum = src + is;
        precise float r = modified - sum;
        return txBound(r);
    }
    case 11: { // LINEAR_HEIGHT
        if (soft) {
            const float modified = txDiv(dst, is);
            const float srcTimesStrength = txMul(src, s);
            precise float multiply = modified * txInv(srcTimesStrength);
            precise float height = modified - srcTimesStrength;
            return txBound(txMax(multiply, height));
        }
        precise float modified = txDiv(dst, is) - is;
        precise float multiply = modified * txInv(src);
        precise float height = modified - src;
        return txBound(txMax(multiply, height));
    }
    case 12: { // HEIGHT_PHOTOSHOP
        precise float weighted = dst * w;
        if (soft) {
            precise float sum = dst + weighted;
            precise float r = sum - txMul(src, s);
            return txBound(r);
        }
        precise float r = weighted - src;
        return txBound(r);
    }
    default: { // LINEAR_HEIGHT_PHOTOSHOP
        precise float weighted = dst * w;
        if (soft) {
            precise float modified = dst + weighted;
            const float srcTimesStrength = txMul(src, s);
            precise float multiply = modified * txInv(srcTimesStrength);
            precise float height = modified - srcTimesStrength;
            return txBound(txMax(multiply, height));
        }
        precise float multiply = txInv(src) * weighted;
        precise float height = weighted - src;
        return txBound(txMax(multiply, height));
    }
    }
}

#ifdef TILE_F16
// RGBA16F textures (phase 4.105): KisMaskingBrushCompositeOp<half, ...>.
// KoColorSpaceMathsTraits<half>::compositetype is double; Imath's half has
// no arithmetic operators, so half +- half is computed in float; every value
// returned as a half rounds double -> float -> half. Arguments and results
// are exact half values held in floats.
float hf(float v) { return roundToHalf(v); }
float hd(double v) { return roundToHalf(float(v)); }
float hMul(float a, float b) { precise double r = double(a) * double(b); return hd(r); }
float hMul3(float a, float b, float c) { precise double ab = double(a) * double(b); precise double r = ab * double(c); return hd(r); }
float hInv(float a) { precise float r = 1.0 - a; return hf(r); }
float hUnion(float a, float b) { precise double s = double(a) + double(b); precise double r = s - double(hMul(a, b)); return hd(r); }
double hDiv(float a, float b) { precise double q = double(a) / double(b); return q; }
double dMin(double a, double b) { return a < b ? a : b; }
double dMax(double a, double b) { return a < b ? b : a; }
double dBound(double v) { return dMax(0.0, dMin(1.0, v)); }
bool hUnitFuzzy(float v) { precise float d = v - 1.0; return abs(d) < 0.002; }
bool hZeroFuzzy(float v) { return abs(v) < 0.002; }
bool hHalfFuzzy(float v) { precise float d = v - 0.5; return abs(d) < 0.001; }

// CFHardLight<half>::composeChannel(src, dst)
float hHardLight(float src, float dst)
{
    if (hHalfFuzzy(src)) return dst;
    precise double src2 = double(src) + double(src);
    if (src > 0.5) {
        src2 = src2 - 1.0;
        return hUnion(hd(src2), dst);
    }
    return hMul(hd(src2), dst);
}
float hOverlay(float src, float dst) { return hHardLight(dst, src); }
// colorDodgeAlpha<half>
float hDodge(float src, float dst)
{
    if (hUnitFuzzy(src)) return hZeroFuzzy(dst) ? 0.0 : 1.0;
    const float result = hd(dBound(hDiv(dst, hInv(src))));
    return (isnan(result) || isinf(result)) ? 1.0 : result;
}
// CFColorBurn<half>
float hBurn(float src, float dst)
{
    if (dst == 1.0) return 1.0;
    const double quotient = hDiv(hInv(dst), src);
    if (isnan(quotient) || isinf(quotient)) return 0.0;
    return hInv(hd(dBound(quotient)));
}
// CFHardMixPhotoshop<half>
float hHardMix(float src, float dst) { precise double sum = double(src) + double(dst); return sum > 1.0 ? 1.0 : 0.0; }
// hardMixSofterPhotoshopAlpha<half>
float hHardMixSofter(float src, float dst)
{
    precise double a = 3.0 * double(dst);
    precise double b = 2.0 * double(hInv(src));
    precise double r = a - b;
    return hd(dBound(r));
}

float texturedAlphaHalf(Circle c, float src, float dst)
{
    const float s = c.textureStrength;
    const float is = c.textureInvertedStrength;
    const double w = double(c.textureWeight);
    const bool soft = c.textureSoft != 0;
    switch (c.textureMode) {
    case 0: // MULT
        return soft ? hMul(hUnion(src, is), dst) : hMul3(src, dst, s);
    case 1: { // DARKEN: qMin of halves
        const float a = soft ? hUnion(src, is) : src;
        const float b = soft ? dst : hMul(dst, s);
        return a < b ? a : b;
    }
    case 2: // OVERLAY
        return soft ? hOverlay(hUnion(src, is), dst) : hOverlay(src, hMul(dst, s));
    case 3: // DODGE
        return soft ? hDodge(hMul(src, s), dst) : hDodge(src, hMul(dst, s));
    case 4: // BURN
        return soft ? hBurn(hUnion(src, is), dst) : hBurn(src, hMul(dst, s));
    case 5: { // LINEAR_BURN
        if (soft) {
            // union + dst - unit in float (half operands)
            precise float sum = hUnion(src, is) + dst;
            precise float r = sum - 1.0;
            return hd(dMax(0.0, double(r)));
        }
        precise double sum = double(src) + double(hMul(dst, s));
        precise double r = sum - 1.0;
        return hd(dMax(0.0, r));
    }
    case 6: { // LINEAR_DODGE
        if (hZeroFuzzy(dst)) return 0.0;
        if (soft) {
            precise float sum = hMul(src, s) + dst;
            return hd(dMin(double(sum), 1.0));
        }
        precise double sum = double(src) + double(hMul(dst, s));
        return hd(dMin(sum, 1.0));
    }
    case 7: // HARD_MIX_PHOTOSHOP
        return soft ? hMul(hHardMix(hUnion(src, is), dst), hUnion(dst, s)) : hHardMix(src, hMul(dst, s));
    case 8: // HARD_MIX_SOFTER_PHOTOSHOP
        return soft ? hHardMixSofter(hMul(src, s), dst) : hHardMixSofter(src, hMul(dst, s));
    case 9: { // SUBTRACT
        if (soft) {
            precise double r = double(dst) - double(hMul(src, s));
            return hd(dMax(0.0, r));
        }
        precise double sum = double(src) + double(is);
        precise double r = double(dst) - sum;
        return hd(dMax(0.0, r));
    }
    case 10: { // HEIGHT
        const double modified = hDiv(dst, is);
        if (soft) {
            precise double r = modified - double(hMul(src, s));
            return hd(dBound(r));
        }
        precise double sum = double(src) + double(is);
        precise double r = modified - sum;
        return hd(dBound(r));
    }
    case 11: { // LINEAR_HEIGHT
        if (soft) {
            const double modified = hDiv(dst, is);
            const float srcTimesStrength = hMul(src, s);
            precise double multiply = modified * double(hInv(srcTimesStrength));
            precise double height = modified - double(srcTimesStrength);
            return hd(dBound(dMax(multiply, height)));
        }
        precise double modified = hDiv(dst, is) - double(is);
        precise double multiply = modified * double(hInv(src));
        precise double height = modified - double(src);
        return hd(dBound(dMax(multiply, height)));
    }
    case 12: { // HEIGHT_PHOTOSHOP
        precise double weighted = double(dst) * w;
        if (soft) {
            precise double sum = double(dst) + weighted;
            precise double r = sum - double(hMul(src, s));
            return hd(dBound(r));
        }
        precise double r = weighted - double(src);
        return hd(dBound(r));
    }
    default: { // LINEAR_HEIGHT_PHOTOSHOP
        precise double weighted = double(dst) * w;
        if (soft) {
            precise double modified = double(dst) + weighted;
            const float srcTimesStrength = hMul(src, s);
            precise double multiply = modified * double(hInv(srcTimesStrength));
            precise double height = modified - double(srcTimesStrength);
            return hd(dBound(dMax(multiply, height)));
        }
        precise double multiply = double(hInv(src)) * weighted;
        precise double height = weighted - double(src);
        return hd(dBound(dMax(multiply, height)));
    }
    }
}
#endif

// The pattern texel of textured-layout pixel p (KisFillPainter's wrap).
float textureTexel(Circle c, ivec2 p)
{
    const int w = int(c.textureWidth);
    const int h = int(c.textureHeight);
    const int x = c.textureOriginX + p.x;
    const int y = c.textureOriginY + p.y;
    const int tx = x >= 0 ? x % w : w - (-x - 1) % w - 1;
    const int ty = y >= 0 ? y % h : h - (-y - 1) % h - 1;
    const uint index = uint(ty * w + tx);
    const uint packed = TextureBytes(c.texture).word[index / 4];
    return TextureLut(c.textureLut).value[(packed >> (8 * (index % 4))) & 255];
}

// Image tip dabs (kind 3, RGBA32F; see KisImageTipSampler): the transformed
// predefined brush tip in integer arithmetic, identical to the CPU's. Only
// the red and alpha channels are computed; the dab alpha is
// Uint8ToFloat(UINT8_MULT(255 - red, alpha)) (fillGrayBrushWithColor()).
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ImageTexels { uint texel[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer ImageRows { ivec4 row[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer ImageTable { float value[]; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer ImageDoubles { double value[]; };

// QRgba64::fromArgb32(p).premultiplied(): red, green, blue, alpha
uvec4 tipPremultiplied(uint p)
{
    const uint a = (p >> 24) * 257u;
    const uvec3 rgb = uvec3((p >> 16) & 255u, (p >> 8) & 255u, p & 255u) * 257u;
    if (a == 65535u)
        return uvec4(rgb, a);
    if (a == 0u)
        return uvec4(0u);
    const uvec3 m = rgb * a;
    return uvec4(((m + (m >> 16) + 0x8000u) >> 16) & 0xffffu, a);
}

// interpolate_4_pixels_rgb64(): _mm_mulhi_epu16 per 16-bit channel, dist != 0
uvec4 tipLerp(uvec4 a, uvec4 b, uint dist)
{
    return (((a * (0x10000u - dist)) >> 16) + ((b * dist) >> 16)) & 0xffffu;
}

uvec4 tipTexel(Circle c, int x, int y)
{
    return tipPremultiplied(ImageTexels(c.imageTexels).texel[y * c.imageWidth + x]);
}

// fetchTransformedBilinear_pixelBounds()
ivec2 tipBounds(int v, int last)
{
    if (v < 0)
        return ivec2(0);
    if (v >= last)
        return ivec2(last);
    return ivec2(v, v + 1);
}

// QRgba64::toArgb32() of one 16-bit channel
uint tipTo8(uint c)
{
    c += 128u;
    return (c - (c >> 8)) >> 8;
}

// unpremultiplied_64bit() of one channel
uint tipUnpremultiply(uint value, uint64_t fa)
{
    return uint((uint64_t(value) * fa + 0x80000000ul) >> 32) & 0xffffu;
}

// The ARGB32 tip pixel (KisImageTipSampler::pixel()) as 8-bit red, green,
// blue, alpha
uvec4 imageTipPixel(Circle c, ivec2 p)
{
    if (c.imageIdentity != 0u) {
        const uint v = ImageTexels(c.imageTexels).texel[(p.y + 1) * c.imageWidth + p.x + 1];
        return uvec4((v >> 16) & 255u, (v >> 8) & 255u, v & 255u, v >> 24);
    }
    const ivec4 row = ImageRows(c.imageRows).row[p.y];
    if (p.x < row.x || p.x >= row.x + row.y)
        return uvec4(0u);
    const int i = p.x - row.x;
    const int fx = row.z + i * c.imageFdx;
    const int fy = row.w + i * c.imageFdy;
    const ivec2 xs = tipBounds(fx >> 16, c.imageWidth - 1);
    const ivec2 ys = tipBounds(fy >> 16, c.imageHeight - 1);
    const uint distx = uint(fx) & 0xffffu;
    const uint disty = uint(fy) & 0xffffu;
    uvec4 left = tipTexel(c, xs.x, ys.x);
    uvec4 right = tipTexel(c, xs.y, ys.x);
    if (disty != 0u) {
        left = tipLerp(left, tipTexel(c, xs.x, ys.y), disty);
        right = tipLerp(right, tipTexel(c, xs.y, ys.y), disty);
    }
    if (distx != 0u)
        left = tipLerp(left, right, distx);
    // QRgba64::unpremultiplied_64bit(), then toArgb32()
    uvec3 rgb = left.xyz;
    const uint a = left.w;
    if (a != 0xffffu && a != 0u) {
        const uint64_t fa = (0xffff00008000ul + uint64_t(a / 2u)) / uint64_t(a);
        rgb = uvec3(tipUnpremultiply(rgb.x, fa), tipUnpremultiply(rgb.y, fa), tipUnpremultiply(rgb.z, fa));
    }
    return uvec4(tipTo8(rgb.x), tipTo8(rgb.y), tipTo8(rgb.z), tipTo8(a));
}

// KisProceduralCircleDab::imageTipValue()
vec4 imageTipValue(Circle c, ivec2 p)
{
    const uvec4 v = imageTipPixel(c, p);
    ImageTable table = ImageTable(c.imageTable);
    if (c.imageApplication == 1u)
        return vec4(table.value[v.x], table.value[256u + v.y], table.value[512u + v.z], table.value[768u + v.w]);
    if (c.imageApplication == 2u)
        return vec4(table.value[v.x], table.value[256u + v.x], table.value[512u + v.x], table.value[768u + v.w]);
    // gradient map: qGray(), and the opacity product in double
    const uint gray = (v.x * 11u + v.y * 16u + v.z * 5u) / 32u;
    const double maskOpacity = ImageDoubles(c.imageTable + 4096ul).value[v.w];
    precise double alpha = double(table.value[768u + gray]) * maskOpacity;
    // RGBA16F: KoColor::setOpacity() rounds to float, then to half
    const float opacity = c.halfPixels != 0u ? roundToHalf(float(alpha)) : float(alpha);
    return vec4(table.value[gray], table.value[256u + gray], table.value[512u + gray], opacity);
}

// the alpha mask (application 0); the unused color channels are dead code
float imageTipAlpha(Circle c, ivec2 p)
{
    const uvec4 v = imageTipPixel(c, p);
    const uint t = (255u - v.x) * v.w + 0x80u;
    return TextureLut(c.textureLut).value[((t >> 8) + t) >> 8];
}

// A generated dab: the circle or image tip, then its texture if any. The
// texture was applied after the brush tip's mirroring (textureBrushFlips).
vec4 generatedDab(Circle c, ivec2 p, int width, int height)
{
    vec4 source = c.kind != 3            ? generatedCircle(c, p)
        : c.imageApplication == 0u ? vec4(c.color.rgb, imageTipAlpha(c, p))
                                   : imageTipValue(c, p);
    if (c.texture != uint64_t(0)) {
        ivec2 tp = p;
        if ((c.textureBrushFlips & 1) != 0) tp.x = width - 1 - tp.x;
        if ((c.textureBrushFlips & 2) != 0) tp.y = height - 1 - tp.y;
#ifdef TILE_F16
        source.a = c.halfPixels != 0u ? texturedAlphaHalf(c, textureTexel(c, tp), source.a)
                                      : texturedAlpha(c, textureTexel(c, tp), source.a);
#else
        source.a = texturedAlpha(c, textureTexel(c, tp), source.a);
#endif
    }
    return source;
}
#endif

vec4 over(vec4 dst, vec4 src, float opacity, float coverage)
{
    float a = (src.a * opacity) * coverage;
    if (a == 0.0) return dst;
    float alpha;
    float blend;
    bool alphaLocked = (params.channelMask & 8) == 0;
    if (alphaLocked || dst.a == 1.0) { alpha = dst.a; blend = a; }
    else if (dst.a == 0.0) {
        alpha = a; blend = 1.0;
        // The CPU scalar Over kernel clears hidden RGB before unlocking
        // alpha when only some color channels are enabled.
        if ((params.channelMask & 7) != 7) dst = vec4(0.0);
    }
    else { alpha = dst.a + (1.0 - dst.a) * a; blend = alpha == 0.0 ? 0.0 : a / alpha; }
    vec3 color = blend == 1.0 ? src.rgb : blend * (src.rgb - dst.rgb) + dst.rgb;
    if ((params.channelMask & 1) == 0) color.r = dst.r;
    if ((params.channelMask & 2) == 0) color.g = dst.g;
    if ((params.channelMask & 4) == 0) color.b = dst.b;
    return vec4(color, alpha);
}

#ifdef TILE_F16
vec4 alphaDarkenHalf(vec4 dst, vec4 src, Dab dab, float coverage)
{
    // KoCompositeOpAlphaDarken<half>, including the legacy hard-flow union.
    bool hard = params.mode == 1;
    float flow = halfValue(dab.flow);
    float opacity = halfValue(hard ? dab.flow * dab.opacity : dab.opacity);
    float average = halfValue(hard ? dab.flow * dab.averageOpacity : dab.averageOpacity);
    float masked = params.mask != uint64_t(0) ? halfValue(halfValue(coverage) * src.a) : src.a;
    float a = halfValue(masked * opacity);
    precise vec3 color = dst.a == 0.0 ? src.rgb : roundedProduct(src.rgb - dst.rgb, a) + dst.rgb;
    float fullAlpha;
    if (average > opacity) {
        fullAlpha = average > dst.a ? halfLerp(a, average, halfValue(dst.a / average)) : dst.a;
    } else {
        fullAlpha = opacity > dst.a ? halfLerp(dst.a, opacity, masked) : dst.a;
    }
    float zeroAlpha = hard ? halfValue(a + dst.a - halfValue(a * dst.a)) : dst.a;
    return vec4(color, dab.flow == 1.0 ? fullAlpha : halfLerp(zeroAlpha, fullAlpha, flow));
}
#endif

vec4 alphaDarken(vec4 dst, vec4 src, Dab dab, float coverage)
{
    // Match KoAlphaDarkenParamsWrapper and KoOptimizedCompositeOpAlphaDarken128.
    bool hard = params.mode == 1;
    float opacity = hard ? dab.flow * dab.opacity : dab.opacity;
    float averageOpacity = hard ? dab.flow * dab.averageOpacity : dab.averageOpacity;
    float maskedAlpha = coverage * src.a;
    float a = maskedAlpha * opacity;
    vec3 color = dst.a == 0.0 ? src.rgb : (src.rgb - dst.rgb) * a + dst.rgb;
    float fullFlowAlpha;
    if (averageOpacity > opacity) {
        fullFlowAlpha = averageOpacity > dst.a
            ? (averageOpacity - a) * (dst.a / averageOpacity) + a : dst.a;
    } else {
        fullFlowAlpha = opacity > dst.a ? (opacity - dst.a) * maskedAlpha + dst.a : dst.a;
    }
    float alpha = fullFlowAlpha;
    if (dab.flow != 1.0) {
        float zeroFlowAlpha = hard ? a + dst.a - a * dst.a : dst.a;
        alpha = (fullFlowAlpha - zeroFlowAlpha) * dab.flow + zeroFlowAlpha;
    }
    return vec4(color, alpha);
}

void main()
{
    uint tile = gl_WorkGroupID.x;
    ivec2 tileOrigin = params.tiles.tile[tile].origin;
    Pixels dst = Pixels(params.tiles.tile[tile].pixels);
    for (uint i = gl_LocalInvocationID.x; i < 4096; i += 256) {
        ivec2 point = tileOrigin + ivec2(i % 64, i / 64);
        float coverage = 1.0;
        float maskByte = 255.0;
        if (params.mask != uint64_t(0)) {
            ivec2 p = point - params.maskOrigin;
            if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, params.maskSize))) continue;
            uint index = uint(p.y * params.maskSize.x + p.x);
            uint packed = MaskBytes(params.mask).word[index / 4];
            maskByte = float((packed >> (8 * (index % 4))) & 255);
            coverage = maskCoverage((packed >> (8 * (index % 4))) & 255, params.mode >= 14);
        }
        vec4 value = vec4(dst.px[i]);
        bool touched = false;
        for (uint j = 0; j < params.dabCount; ++j) {
            Dab dab = params.dabs.dab[j];
            ivec2 clipped = point - dab.clip.xy;
            if (any(lessThan(clipped, ivec2(0))) || any(greaterThanEqual(clipped, dab.clip.zw))) continue;
            ivec2 p = point - ivec2(dab.x, dab.y);
            if (p.x < 0 || p.y < 0 || p.x >= dab.width || p.y >= dab.height) continue;
            if ((dab.mirrorFlags & 1) != 0) p.x = dab.width - 1 - p.x;
            if ((dab.mirrorFlags & 2) != 0) p.y = dab.height - 1 - p.y;
#ifdef DAB_TEXTURE
            vec4 source = (dab.mirrorFlags & 4) != 0 ? generatedDab(Circles(dab.pixels).circle, p, dab.width, dab.height)
                                                     : vec4(Pixels(dab.pixels).px[p.y * dab.width + p.x]);
#else
            vec4 source = (dab.mirrorFlags & 4) != 0 ? generatedCircle(Circles(dab.pixels).circle, p)
                                                     : vec4(Pixels(dab.pixels).px[p.y * dab.width + p.x]);
#endif
#ifdef TILE_F16
            if (params.mode == 3) {
                value = eraseHalf(value, source, dab.opacity, coverage, params.mask != uint64_t(0));
            } else if (params.mode == 0) {
                value = overHalf(value, source, dab.opacity, maskByte, params.mask != uint64_t(0),
                                 params.channelMask & 15, (params.channelMask & 16) != 0);
            } else if (params.mode >= 4) {
                uint op = params.mode - (params.mode < 14 ? 3 : 2);
                value = compositeGeneric(op, value, source, dab.opacity, false, coverage, params.channelMask & 15);
            } else {
                value = alphaDarkenHalf(value, source, dab, coverage);
            }
            value = vec4(f16vec4(value)); // CPU stores after every individual dab
#else
            if (params.mode == 3) {
                // KoCompositeOpErase: mask first, then opacity. Preserve RGB,
                // including hidden RGB when alpha reaches zero. Flow is unused.
                float erased = (source.a * coverage) * dab.opacity;
                value.a = (1.0 - erased) * value.a;
            } else if (params.mode >= 4) {
                // Skip the layer enum's Erase slot: dabs 4..13 -> ops 1..10,
                // dabs 14 and above -> ops 12 and above. Keep existing IDs stable.
                uint op = params.mode - (params.mode < 14 ? 3 : 2);
                value = compositeGeneric(op, value, source, dab.opacity, false, coverage, params.channelMask);
            } else {
                value = params.mode == 0 ? over(value, source, dab.opacity, coverage)
                                        : alphaDarken(value, source, dab, coverage);
            }
#endif
            touched = true;
        }
        if (touched) dst.px[i] = PIXEL(value);
    }
}
