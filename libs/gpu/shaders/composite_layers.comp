 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * Composites a list of layers, bottom to top, onto destination tiles
 * (GPU engine phase 2, projection). Only pixels inside the clip rect are
 * written; the rest of every destination tile is left untouched.
 *
 * Blend modes reproduce Krita's RGBA float composite ops:
 *  - Over: KoOptimizedCompositeOpOver128
 *  - Erase: KoCompositeOpErase, preserving RGB even at zero alpha
 *  - HSY modes: KoCompositeOpGenericHSLFunctor
 *  - the others: KoCompositeOpGenericSC with the cf* functions of
 *    KoCompositeOpFunctions.h and their clamp policies
 *  - KoCompositeOpBase: a destination pixel with alpha exactly 0 is cleared
 *    when any channel is locked (not all channel flags set).
 * Soft Light uses double intermediates on the CPU; this shader uses float.
 *
 * Compile with -DTILE_F16 for RGBA16F tiles; the result is then rounded to
 * half after every layer, as Krita does when compositing into an F16 device.
 */
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#ifdef TILE_F16
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define PIXEL f16vec4
#define LOAD_PIXEL(v) vec4(v)
#define STORE_PIXEL(v) f16vec4(v)
#else
#define PIXEL vec4
#define LOAD_PIXEL(v) (v)
#define STORE_PIXEL(v) (v)
#endif

#extension GL_GOOGLE_include_directive : require
#include "composite_blend.glsl"
#include "composite_over.glsl"
#ifdef TILE_F16
#include "composite_half_brush.glsl"
#endif

const uint FlagAlphaLocked = 1;
// Replace: the pixel becomes the layer's pixel (its default pixel, fill, where
// the layer has no tile), ignoring opacity, channels and coverage, like a
// COMPOSITE_COPY blit (KisPainter::copyAreaOptimized with equal defaults).
const uint FlagReplace = 8;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer MaskBytes
{
    uint word[];
};

layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 8) buffer TilePixels
{
    PIXEL px[];
};

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer AddressTable
{
    uint64_t addr[];
};

// A layer has its own tile table: tableWidth tiles per row, starting at
// layerTiles[tableOffset]. The pixel at grid position p is pixel (p + bias) of
// that table. bias is 0 for a layer on the destination grid; a layer shifted
// by s (1..63 per axis, phase 4.112) has one more column and row, and
// bias = 64 - s.
struct LayerParams {
    float opacity;
    uint op;
    uint flags;
    uint channelMask;
    vec4 fill;
    ivec2 bias;
    uint tableOffset;
    uint tableWidth;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer LayerTable
{
    LayerParams layers[];
};

layout(push_constant) uniform Params
{
    AddressTable layerTiles; // every layer's tile table (LayerParams); 0 = transparent tile
    AddressTable dstTiles; // tileCount
    LayerTable layers; // layerCount
    uint tileCount;
    uint layerCount;
    uint gridWidth; // tiles per row
    uint padding0;
    uint padding1;
    uint padding2;
    ivec4 clip; // x0, y0, x1, y1 (exclusive) in grid pixel coordinates
    uint64_t mask;
    ivec2 maskOrigin;
    ivec2 maskSize;
    uvec2 maskPadding;
}
params;

const uint PixelsPerTile = 64 * 64;
const uint PixelsPerInvocation = PixelsPerTile / gl_WorkGroupSize.x;


void main()
{
    const uint tile = gl_WorkGroupID.x;
    if (tile >= params.tileCount) {
        return;
    }

    const ivec2 tileOrigin = ivec2(int(tile % params.gridWidth), int(tile / params.gridWidth)) * 64;
    TilePixels dstTile = TilePixels(params.dstTiles.addr[tile]);

    for (uint i = 0; i < PixelsPerInvocation; i++) {
        const uint index = gl_LocalInvocationID.x + i * gl_WorkGroupSize.x;
        const ivec2 position = tileOrigin + ivec2(int(index % 64), int(index / 64));
        if (any(lessThan(position, params.clip.xy)) || any(greaterThanEqual(position, params.clip.zw))) {
            continue;
        }

        float coverage = 1.0;
        float maskByte = 255.0;
        bool outsideMask = false;
        if (params.mask != uint64_t(0)) {
            const ivec2 p = position - params.maskOrigin;
            if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, params.maskSize))) {
                // Only replace layers apply outside the coverage.
                outsideMask = true;
            } else {
                const uint maskIndex = uint(p.y * params.maskSize.x + p.x);
                const uint packed = MaskBytes(params.mask).word[maskIndex / 4];
                maskByte = float((packed >> (8 * (maskIndex % 4))) & 255);
                // Coverage is restricted to one blended (top) layer by the host-side API.
                coverage = maskCoverage((packed >> (8 * (maskIndex % 4))) & 255,
                                        params.layers.layers[params.layerCount - 1].op >= OpLinearBurn);
            }
        }
        vec4 result = LOAD_PIXEL(dstTile.px[index]);
        for (uint layer = 0; layer < params.layerCount; layer++) {
            const LayerParams info = params.layers.layers[layer];
            const ivec2 source = position + info.bias;
            const uint64_t address =
                params.layerTiles.addr[info.tableOffset + uint(source.y >> 6) * info.tableWidth + uint(source.x >> 6)];
            const uint sourceIndex = uint((source.y & 63) * 64 + (source.x & 63));
            if ((info.flags & FlagReplace) != 0) {
                const vec4 copied = address == 0 ? info.fill : LOAD_PIXEL(TilePixels(address).px[sourceIndex]);
                if (info.channelMask == 0xf) {
                    result = copied;
                    continue;
                }
                // The Copy composite op at full opacity with channel flags
                // (KoCompositeOpCopy2; the scalar KoOptimizedCompositeOpCopy128).
                if ((info.channelMask & 8) == 0) {
                    // alpha locked: a transparent source pixel changes nothing
                    if (copied.a == 0.0) {
                        continue;
                    }
                } else {
                    if (result.a == 0.0) {
                        result.rgb = vec3(0.0);
                    }
                    result.a = copied.a;
                }
                if ((info.channelMask & 1) != 0) result.r = copied.r;
                if ((info.channelMask & 2) != 0) result.g = copied.g;
                if ((info.channelMask & 4) != 0) result.b = copied.b;
                continue;
            }
            if (address == 0 || outsideMask) {
                continue;
            }
            const vec4 src = LOAD_PIXEL(TilePixels(address).px[sourceIndex]);
            const bool alphaLocked = (info.flags & FlagAlphaLocked) != 0;
#ifdef TILE_F16
            if ((info.flags & 2) != 0) {
                uint channels = alphaLocked ? info.channelMask & 7 : info.channelMask;
                result = info.op == OpErase
                    ? eraseHalf(result, src, info.opacity, coverage, params.mask != uint64_t(0))
                    : overHalf(result, src, info.opacity, maskByte, params.mask != uint64_t(0), channels,
                               (info.flags & 4) != 0);
            } else
#endif
            if (info.op == OpOver) {
                result = compositeOver(result, src, info.opacity, alphaLocked, coverage, info.channelMask);
            } else if (info.op == OpErase) {
                // CPU KoCompositeOpErase ignores channel flags, including alpha lock.
                result.a = (1.0 - (src.a * coverage) * info.opacity) * result.a;
            } else {
                result = compositeGeneric(info.op, result, src, info.opacity, alphaLocked, coverage, info.channelMask);
            }
#ifdef TILE_F16
            // Krita's F16 ops store every intermediate result as half: round
            // after each layer, like compositing into an F16 device one by one.
            result = vec4(f16vec4(result));
#endif
        }
        dstTile.px[index] = STORE_PIXEL(result);
    }
}
