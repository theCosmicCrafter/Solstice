#if defined(__MINGW64__) || defined(__MINGW32__)
#include <afxres.h>
#include <winresrc.h>
#else
#include <winres.h>
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

// CMake defines:

#define KRITA_VERSION_STRING "${KRITA_VERSION_STRING}"

#define KRITA_STABLE_VERSION_MAJOR ${KRITA_STABLE_VERSION_MAJOR}
#define KRITA_STABLE_VERSION_MINOR ${KRITA_STABLE_VERSION_MINOR}
#define KRITA_VERSION_RELEASE ${KRITA_VERSION_RELEASE}
#define KRITA_VERSION_REVISION ${KRITA_VERSION_REVISION}

// Solstice's own version (docs/agent/versioning.md) is the file version.
#define SOLSTICE_VERSION_STRING "${SOLSTICE_VERSION_STRING}"
#define SOLSTICE_VERSION_MAJOR ${SOLSTICE_VERSION_MAJOR}
#define SOLSTICE_VERSION_MINOR ${SOLSTICE_VERSION_MINOR}
#define SOLSTICE_VERSION_PATCH ${SOLSTICE_VERSION_PATCH}
#define SOLSTICE_VERSION_BUILD ${SOLSTICE_VERSION_BUILD}

#cmakedefine KRITA_GIT_SHA1_STRING
#ifdef KRITA_GIT_SHA1_STRING
#undef KRITA_GIT_SHA1_STRING
#define KRITA_GIT_SHA1_STRING "${KRITA_GIT_SHA1_STRING}"
#endif

// ---

#ifdef KRITA_GIT_SHA1_STRING
#define KRITA_FULL_VERSION_STRING SOLSTICE_VERSION_STRING " (git " KRITA_GIT_SHA1_STRING ")"
#else
#define KRITA_FULL_VERSION_STRING SOLSTICE_VERSION_STRING
#endif

//#define KRITA_IS_DLL
//#define KRITA_IS_DEBUG
#define KRITA_FILE_VERSION SOLSTICE_VERSION_MAJOR,SOLSTICE_VERSION_MINOR,SOLSTICE_VERSION_PATCH,SOLSTICE_VERSION_BUILD
#define KRITA_FILE_VERSION_STR KRITA_FULL_VERSION_STRING
#define KRITA_PRODUCT_VERSION KRITA_FILE_VERSION
#define KRITA_PRODUCT_VERSION_STR KRITA_FILE_VERSION_STR

#define KRITA_DESCRIPTION_STR "Solstice digital painting application"
#define SOLSTICE_PROJECT_STR "Solstice Project"
// The same text as the KAboutData copyright in main.cc
#define SOLSTICE_COPYRIGHT_STR "© 1999–2026 The Krita Developers; Solstice modifications © 2026 The Solstice Contributors"


VS_VERSION_INFO VERSIONINFO
FILEVERSION KRITA_FILE_VERSION
PRODUCTVERSION KRITA_PRODUCT_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef KRITA_IS_DEBUG
FILEFLAGS VERKRITA_IS_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS__WINDOWS32
#ifdef KRITA_IS_DLL
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", SOLSTICE_PROJECT_STR
            VALUE "FileDescription", KRITA_DESCRIPTION_STR
            VALUE "FileVersion", KRITA_FILE_VERSION_STR
            VALUE "InternalName", "solstice"
            VALUE "LegalCopyright", SOLSTICE_COPYRIGHT_STR
            VALUE "OriginalFilename", "solstice.exe"
            VALUE "ProductName", "Solstice"
            VALUE "ProductVersion", KRITA_PRODUCT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
