;
;  SPDX-License-Identifier: GPL-3.0-or-later
;
; Solstice installer (64-bit). It replaces Krita's installer_krita.nsi: it
; installs under its own names (Program Files\Solstice, HKLM\Software\Solstice,
; the "Solstice" uninstall entry) and never detects, removes or modifies a
; Krita installation. It does not take over file associations; Explorer
; thumbnails are registered per user with shellex\register-thumbnails.ps1
; (docs/agent/windows-shell-thumbnails.md).

!ifndef SOLSTICE_PACKAGE_ROOT
	!error "SOLSTICE_PACKAGE_ROOT should be defined and point to the root of the package files."
!endif
!define /ifndef SOLSTICE_VERSION "0.0.0.0"
!define /ifndef SOLSTICE_VERSION_DISPLAY "test-version"
!define /ifndef SOLSTICE_INSTALLER_OUTPUT "solstice-setup-x64.exe"

!define SOLSTICE_PRODUCTNAME "Solstice"
!define SOLSTICE_PUBLISHER "Solstice Project"
!define SOLSTICE_REGKEY "Software\Solstice"
!define SOLSTICE_UNINSTALL_REGKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Solstice"
!define SOLSTICE_URL "https://github.com/udtren/Solstice"

Unicode true
ManifestDPIAware true
RequestExecutionLevel admin

VIProductVersion "${SOLSTICE_VERSION}"
VIAddVersionKey "CompanyName" "${SOLSTICE_PUBLISHER}"
VIAddVersionKey "FileDescription" "${SOLSTICE_PRODUCTNAME} ${SOLSTICE_VERSION_DISPLAY} Setup"
VIAddVersionKey "FileVersion" "${SOLSTICE_VERSION}"
VIAddVersionKey "LegalCopyright" "© 1999–2026 The Krita Developers; Solstice modifications © 2026 The Solstice Contributors"
VIAddVersionKey "ProductName" "${SOLSTICE_PRODUCTNAME} ${SOLSTICE_VERSION_DISPLAY} Setup"
VIAddVersionKey "ProductVersion" "${SOLSTICE_VERSION}"

Name "${SOLSTICE_PRODUCTNAME} ${SOLSTICE_VERSION_DISPLAY}"
BrandingText "${SOLSTICE_PRODUCTNAME} ${SOLSTICE_VERSION_DISPLAY}"
OutFile "${SOLSTICE_INSTALLER_OUTPUT}"
InstallDir "$PROGRAMFILES64\Solstice"
InstallDirRegKey HKLM "${SOLSTICE_REGKEY}" "InstallLocation"
ShowInstDetails show
ShowUninstDetails show

!include MUI2.nsh
!include LogicLib.nsh
!include x64.nsh
!include "include\IsFileInUse.nsh"

; krita.ico is the Solstice icon generated by the build (installer/ folder)
!define MUI_ICON "krita.ico"
!define MUI_UNICON "krita.ico"
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\bin\solstice.exe"
!define MUI_FINISHPAGE_NOAUTOCLOSE

Var StartMenuFolder

!insertmacro MUI_PAGE_WELCOME
!define MUI_LICENSEPAGE_CHECKBOX
!insertmacro MUI_PAGE_LICENSE "license_gpl-3.0.rtf"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!define MUI_STARTMENUPAGE_DEFAULTFOLDER "Solstice"
!define MUI_STARTMENUPAGE_REGISTRY_ROOT HKLM
!define MUI_STARTMENUPAGE_REGISTRY_KEY "${SOLSTICE_REGKEY}"
!define MUI_STARTMENUPAGE_REGISTRY_VALUENAME "StartMenuFolder"
!insertmacro MUI_PAGE_STARTMENU Solstice $StartMenuFolder
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!define MUI_PAGE_CUSTOMFUNCTION_PRE un.CheckNotRunning
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Function .onInit
	${IfNot} ${RunningX64}
		MessageBox MB_OK|MB_ICONSTOP "Solstice requires 64-bit Windows."
		Abort
	${EndIf}
	SetRegView 64
	; An existing installation must not be running while it is replaced
	ReadRegStr $R0 HKLM "${SOLSTICE_REGKEY}" "InstallLocation"
	${If} $R0 != ""
	${AndIf} ${IsFileInUse} "$R0\bin\solstice.exe"
		MessageBox MB_OK|MB_ICONEXCLAMATION "Solstice is running. Close it and start the installer again."
		Abort
	${EndIf}
FunctionEnd

Function un.onInit
	SetRegView 64
FunctionEnd

Function un.CheckNotRunning
	${If} ${IsFileInUse} "$INSTDIR\bin\solstice.exe"
		MessageBox MB_OK|MB_ICONEXCLAMATION "Solstice is running. Close it and start the uninstaller again."
		Quit
	${EndIf}
FunctionEnd

; A previous Solstice installation (only Solstice's own registry key is read)
Section "-Remove previous version" SEC_remove_previous
	ReadRegStr $R0 HKLM "${SOLSTICE_REGKEY}" "InstallLocation"
	${If} $R0 != ""
	${AndIf} ${FileExists} "$R0\uninstall.exe"
		DetailPrint "Removing the previous version of Solstice..."
		ExecWait '"$R0\uninstall.exe" /S _?=$R0' $R1
		${If} $R1 != 0
			MessageBox MB_OK|MB_ICONSTOP "The previous version of Solstice could not be removed."
			Abort
		${EndIf}
		Delete "$R0\uninstall.exe"
		RMDir "$R0"
	${EndIf}
SectionEnd

Section "Solstice" SEC_main
	SectionIn RO
	SetOutPath "$INSTDIR"
	File /r "${SOLSTICE_PACKAGE_ROOT}\bin"
	File /r "${SOLSTICE_PACKAGE_ROOT}\lib"
	File /r "${SOLSTICE_PACKAGE_ROOT}\share"
	File /nonfatal /r "${SOLSTICE_PACKAGE_ROOT}\python"
	File /nonfatal /r "${SOLSTICE_PACKAGE_ROOT}\shellex"
	WriteUninstaller "$INSTDIR\uninstall.exe"

	WriteRegStr HKLM "${SOLSTICE_REGKEY}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKLM "${SOLSTICE_REGKEY}" "Version" "${SOLSTICE_VERSION}"

	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "DisplayName" "${SOLSTICE_PRODUCTNAME} ${SOLSTICE_VERSION_DISPLAY}"
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "DisplayVersion" "${SOLSTICE_VERSION_DISPLAY}"
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "Publisher" "${SOLSTICE_PUBLISHER}"
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "DisplayIcon" '"$INSTDIR\bin\solstice.exe",0'
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "URLInfoAbout" "${SOLSTICE_URL}"
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "InstallLocation" "$INSTDIR"
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "UninstallString" '"$INSTDIR\uninstall.exe"'
	WriteRegStr HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "QuietUninstallString" '"$INSTDIR\uninstall.exe" /S'
	WriteRegDWORD HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "NoModify" 1
	WriteRegDWORD HKLM "${SOLSTICE_UNINSTALL_REGKEY}" "NoRepair" 1

	!insertmacro MUI_STARTMENU_WRITE_BEGIN Solstice
		CreateDirectory "$SMPROGRAMS\$StartMenuFolder"
		CreateShortcut "$SMPROGRAMS\$StartMenuFolder\Solstice.lnk" "$INSTDIR\bin\solstice.exe"
		CreateShortcut "$SMPROGRAMS\$StartMenuFolder\Uninstall Solstice.lnk" "$INSTDIR\uninstall.exe"
	!insertmacro MUI_STARTMENU_WRITE_END
SectionEnd

Section "Desktop shortcut" SEC_desktop
	CreateShortcut "$DESKTOP\Solstice.lnk" "$INSTDIR\bin\solstice.exe"
SectionEnd

; Per-user registration of the Krita Shell Extension shipped in shellex\ (the
; installing user only; other users run shellex\register-thumbnails.cmd)
Section "Explorer thumbnails for .kra and .krz" SEC_thumbnails
	${If} ${FileExists} "$INSTDIR\shellex\register-thumbnails.ps1"
		DetailPrint "Registering Explorer thumbnails for the current user..."
		nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\shellex\register-thumbnails.ps1"'
		Pop $R0
		WriteRegDWORD HKLM "${SOLSTICE_REGKEY}" "ThumbnailsRegistered" 1
	${EndIf}
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
	!insertmacro MUI_DESCRIPTION_TEXT ${SEC_main} "Solstice and its resources."
	!insertmacro MUI_DESCRIPTION_TEXT ${SEC_desktop} "A Solstice shortcut on the desktop."
	!insertmacro MUI_DESCRIPTION_TEXT ${SEC_thumbnails} "Show previews of .kra and .krz files in Explorer for your account. Solstice does not change which program opens these files."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
	ReadRegDWORD $R0 HKLM "${SOLSTICE_REGKEY}" "ThumbnailsRegistered"
	${If} $R0 == 1
	${AndIf} ${FileExists} "$INSTDIR\shellex\register-thumbnails.ps1"
		nsExec::ExecToLog 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\shellex\register-thumbnails.ps1" -Unregister'
		Pop $R1
	${EndIf}

	Delete "$DESKTOP\Solstice.lnk"
	!insertmacro MUI_STARTMENU_GETFOLDER Solstice $StartMenuFolder
	Delete "$SMPROGRAMS\$StartMenuFolder\Solstice.lnk"
	Delete "$SMPROGRAMS\$StartMenuFolder\Uninstall Solstice.lnk"
	RMDir "$SMPROGRAMS\$StartMenuFolder"

	RMDir /r "$INSTDIR\bin"
	RMDir /r "$INSTDIR\lib"
	RMDir /r "$INSTDIR\share"
	RMDir /r "$INSTDIR\python"
	RMDir /r "$INSTDIR\shellex"
	Delete "$INSTDIR\uninstall.exe"
	RMDir "$INSTDIR"

	DeleteRegKey HKLM "${SOLSTICE_UNINSTALL_REGKEY}"
	DeleteRegKey HKLM "${SOLSTICE_REGKEY}"
SectionEnd
